<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/daily_widget_background">

    <TextView
        android:id="@+id/daily_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily teaching"
        android:textColor="@color/daily_widget_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_widget_excerpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/daily_widget_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/daily_widget_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Open the app to prepare readings"
        android:textColor="@color/daily_widget_reference"
        android:textSize="12sp" />
</LinearLayout>
